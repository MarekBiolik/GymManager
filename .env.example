# Copy to .env.local (gitignored). Never commit real keys.
# Clients use the anon key only — never service_role.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Vite (apps/web) — same values, VITE_ prefix required:
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Google OAuth (Supabase Dashboard, not in this file):
# - Site URL: http://localhost:5173 (Vite dev)
# - Additional Redirect URLs: http://localhost:5173/** (and production origin when deployed)
# - Google Cloud Web client redirect URI: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
# See docs/specs/idp-config-checklist.md. Live sign-in smoke requires maintainer IdP setup (#73).
